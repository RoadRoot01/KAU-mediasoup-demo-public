# mediasoup-demo server configuration
# All variables are optional unless noted. Defaults are suitable for local LAN use.

# Signaling / HTTPS API port (default: 4443)
HTTP_LISTEN_PORT=4443

# Server domain / Origin check (default: auto-detected local IPv4)
# DOMAIN=127.0.0.1

# mediasoup worker listening address (default: 0.0.0.0)
MEDIASOUP_LISTEN_IP=0.0.0.0

# Announced address for WebRTC ICE candidates (default: auto-detected local IPv4)
# MEDIASOUP_ANNOUNCED_ADDRESS=

# Optional external TLS files. Set both values together.
# Relative paths are resolved from the server directory.
# TLS_CERT=
# TLS_KEY=

# Enable network-throttle controls only when you set a strong random value locally.
# Never commit the real value or share URLs that contain it.
# NETWORK_THROTTLE_SECRET=

# Optional debug logging, for example: mediasoup*
# DEBUG=mediasoup*